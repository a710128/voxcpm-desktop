{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "VoxCPM Desktop",
  "version": "0.1.0",
  "identifier": "com.example.voxcpm-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoxCPM Desktop",
        "width": 960,
        "height": 760,
        "dragDropEnabled": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "minWidth": 960,
        "minHeight": 760,
        "maxWidth": 960,
        "maxHeight": 760
      }
    ]
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/engine"],
    "resources": ["resources/cuda/"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
